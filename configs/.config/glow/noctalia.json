{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#f2f2f3",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#afb3b6"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#75b2d7",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#1b2022",
    "background_color": "#75b2d7",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#a1c7de",
    "bold": false
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#616b71",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#6b76c7",
    "underline": true
  },
  "link_text": {
    "color": "#75b2d7",
    "bold": true
  },
  "image": {
    "color": "#8f70c2",
    "underline": true
  },
  "image_text": {
    "color": "#616b71"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#8f70c2",
    "background_color": "#212b30"
  },
  "code_block": {
    "color": "#f2f2f3",
    "margin": 2,
    "chroma": {
      "text": { "color": "#f2f2f3" },
      "error": {
        "color": "#1b2022",
        "background_color": "#fd4663"
      },
      "comment": { "color": "#616b71" },
      "keyword": { "color": "#75b2d7" },
      "keyword_reserved": { "color": "#8f70c2" },
      "keyword_type": { "color": "#6b76c7" },
      "operator": { "color": "#8f70c2" },
      "punctuation": { "color": "#afb3b6" },
      "name": { "color": "#f2f2f3" },
      "name_builtin": { "color": "#a1c7de" },
      "name_function": { "color": "#75b2d7" },
      "literal_number": { "color": "#a3a9dc" },
      "literal_string": { "color": "#6b76c7" },
      "generic_deleted": { "color": "#fd4663" },
      "generic_inserted": { "color": "#a3a9dc" },
      "background": { "background_color": "#1a2023" }
    }
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  }
}
