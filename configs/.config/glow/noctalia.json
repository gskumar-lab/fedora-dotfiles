{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#e5e1e4",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#c7c5cd"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#c1c5e3",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#2b2f46",
    "background_color": "#c1c5e3",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#c1c5e3",
    "bold": false
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#919097",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#c6c5d2",
    "underline": true
  },
  "link_text": {
    "color": "#c1c5e3",
    "bold": true
  },
  "image": {
    "color": "#e0bcd5",
    "underline": true
  },
  "image_text": {
    "color": "#919097"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#e0bcd5",
    "background_color": "#46464d"
  },
  "code_block": {
    "color": "#e5e1e4",
    "margin": 2,
    "chroma": {
      "text": { "color": "#e5e1e4" },
      "error": {
        "color": "#690005",
        "background_color": "#ffb4ab"
      },
      "comment": { "color": "#919097" },
      "keyword": { "color": "#c1c5e3" },
      "keyword_reserved": { "color": "#e0bcd5" },
      "keyword_type": { "color": "#c6c5d2" },
      "operator": { "color": "#e0bcd5" },
      "punctuation": { "color": "#c7c5cd" },
      "name": { "color": "#e5e1e4" },
      "name_builtin": { "color": "#c1c5e3" },
      "name_function": { "color": "#c1c5e3" },
      "literal_number": { "color": "#c6c5d2" },
      "literal_string": { "color": "#c6c5d2" },
      "generic_deleted": { "color": "#ffb4ab" },
      "generic_inserted": { "color": "#c6c5d2" },
      "background": { "background_color": "#131315" }
    }
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  }
}
