{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#f3f2f2",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#b6afb4"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#c18bb0",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#221b20",
    "background_color": "#c18bb0",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#d3acc6",
    "bold": false
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#72636d",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#c76b79",
    "underline": true
  },
  "link_text": {
    "color": "#c18bb0",
    "bold": true
  },
  "image": {
    "color": "#b28f80",
    "underline": true
  },
  "image_text": {
    "color": "#72636d"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#b28f80",
    "background_color": "#30212c"
  },
  "code_block": {
    "color": "#f3f2f2",
    "margin": 2,
    "chroma": {
      "text": { "color": "#f3f2f2" },
      "error": {
        "color": "#221b20",
        "background_color": "#fd4663"
      },
      "comment": { "color": "#72636d" },
      "keyword": { "color": "#c18bb0" },
      "keyword_reserved": { "color": "#b28f80" },
      "keyword_type": { "color": "#c76b79" },
      "operator": { "color": "#b28f80" },
      "punctuation": { "color": "#b6afb4" },
      "name": { "color": "#f3f2f2" },
      "name_builtin": { "color": "#d3acc6" },
      "name_function": { "color": "#c18bb0" },
      "literal_number": { "color": "#dca3ab" },
      "literal_string": { "color": "#c76b79" },
      "generic_deleted": { "color": "#fd4663" },
      "generic_inserted": { "color": "#dca3ab" },
      "background": { "background_color": "#231a20" }
    }
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  }
}
