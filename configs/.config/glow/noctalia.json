{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#e4e2e5",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#c6c6cf"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#b9c5f1",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#232f52",
    "background_color": "#b9c5f1",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#b9c5f1",
    "bold": false
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#8f9099",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#c2c6d9",
    "underline": true
  },
  "link_text": {
    "color": "#b9c5f1",
    "bold": true
  },
  "image": {
    "color": "#e4b9e0",
    "underline": true
  },
  "image_text": {
    "color": "#8f9099"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#e4b9e0",
    "background_color": "#45464e"
  },
  "code_block": {
    "color": "#e4e2e5",
    "margin": 2,
    "chroma": {
      "text": { "color": "#e4e2e5" },
      "error": {
        "color": "#690005",
        "background_color": "#ffb4ab"
      },
      "comment": { "color": "#8f9099" },
      "keyword": { "color": "#b9c5f1" },
      "keyword_reserved": { "color": "#e4b9e0" },
      "keyword_type": { "color": "#c2c6d9" },
      "operator": { "color": "#e4b9e0" },
      "punctuation": { "color": "#c6c6cf" },
      "name": { "color": "#e4e2e5" },
      "name_builtin": { "color": "#b9c5f1" },
      "name_function": { "color": "#b9c5f1" },
      "literal_number": { "color": "#c2c6d9" },
      "literal_string": { "color": "#c2c6d9" },
      "generic_deleted": { "color": "#ffb4ab" },
      "generic_inserted": { "color": "#c2c6d9" },
      "background": { "background_color": "#131316" }
    }
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  }
}
