{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#f3f2f2",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#b6b2af"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#d79a75",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#221e1b",
    "background_color": "#d79a75",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#deb8a1",
    "bold": false
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#706760",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#c7bc6b",
    "underline": true
  },
  "link_text": {
    "color": "#d79a75",
    "bold": true
  },
  "image": {
    "color": "#a3c270",
    "underline": true
  },
  "image_text": {
    "color": "#706760"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#a3c270",
    "background_color": "#302721"
  },
  "code_block": {
    "color": "#f3f2f2",
    "margin": 2,
    "chroma": {
      "text": { "color": "#f3f2f2" },
      "error": {
        "color": "#f8f2ee",
        "background_color": "#aa5a29"
      },
      "comment": { "color": "#706760" },
      "keyword": { "color": "#d79a75" },
      "keyword_reserved": { "color": "#a3c270" },
      "keyword_type": { "color": "#c7bc6b" },
      "operator": { "color": "#a3c270" },
      "punctuation": { "color": "#b6b2af" },
      "name": { "color": "#f3f2f2" },
      "name_builtin": { "color": "#deb8a1" },
      "name_function": { "color": "#d79a75" },
      "literal_number": { "color": "#dcd5a3" },
      "literal_string": { "color": "#c7bc6b" },
      "generic_deleted": { "color": "#aa5a29" },
      "generic_inserted": { "color": "#dcd5a3" },
      "background": { "background_color": "#231d1a" }
    }
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  }
}
