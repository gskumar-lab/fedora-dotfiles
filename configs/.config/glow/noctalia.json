{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#f2f3f3",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#afb5b6"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#75bfd7",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#1b2122",
    "background_color": "#75bfd7",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#a1cfde",
    "bold": false
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#5f6c6f",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#6b83c7",
    "underline": true
  },
  "link_text": {
    "color": "#75bfd7",
    "bold": true
  },
  "image": {
    "color": "#8470c2",
    "underline": true
  },
  "image_text": {
    "color": "#5f6c6f"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#8470c2",
    "background_color": "#212d30"
  },
  "code_block": {
    "color": "#f2f3f3",
    "margin": 2,
    "chroma": {
      "text": { "color": "#f2f3f3" },
      "error": {
        "color": "#1b2122",
        "background_color": "#fd4663"
      },
      "comment": { "color": "#5f6c6f" },
      "keyword": { "color": "#75bfd7" },
      "keyword_reserved": { "color": "#8470c2" },
      "keyword_type": { "color": "#6b83c7" },
      "operator": { "color": "#8470c2" },
      "punctuation": { "color": "#afb5b6" },
      "name": { "color": "#f2f3f3" },
      "name_builtin": { "color": "#a1cfde" },
      "name_function": { "color": "#75bfd7" },
      "literal_number": { "color": "#a3b2dc" },
      "literal_string": { "color": "#6b83c7" },
      "generic_deleted": { "color": "#fd4663" },
      "generic_inserted": { "color": "#a3b2dc" },
      "background": { "background_color": "#1a2123" }
    }
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  }
}
