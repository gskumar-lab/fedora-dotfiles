{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#f2f2f3",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#b4afb6"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#b675d7",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#201b22",
    "background_color": "#b675d7",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#c9a1de",
    "bold": false
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#6e6473",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#c76bb8",
    "underline": true
  },
  "link_text": {
    "color": "#b675d7",
    "bold": true
  },
  "image": {
    "color": "#c2708b",
    "underline": true
  },
  "image_text": {
    "color": "#6e6473"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#c2708b",
    "background_color": "#2b2130"
  },
  "code_block": {
    "color": "#f2f2f3",
    "margin": 2,
    "chroma": {
      "text": { "color": "#f2f2f3" },
      "error": {
        "color": "#201b22",
        "background_color": "#fd4663"
      },
      "comment": { "color": "#6e6473" },
      "keyword": { "color": "#b675d7" },
      "keyword_reserved": { "color": "#c2708b" },
      "keyword_type": { "color": "#c76bb8" },
      "operator": { "color": "#c2708b" },
      "punctuation": { "color": "#b4afb6" },
      "name": { "color": "#f2f2f3" },
      "name_builtin": { "color": "#c9a1de" },
      "name_function": { "color": "#b675d7" },
      "literal_number": { "color": "#dca3d3" },
      "literal_string": { "color": "#c76bb8" },
      "generic_deleted": { "color": "#fd4663" },
      "generic_inserted": { "color": "#dca3d3" },
      "background": { "background_color": "#201a23" }
    }
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  }
}
